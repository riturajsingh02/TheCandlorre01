# The Candlorre — Production Environment Configuration Template
# Set all required values in the Render Environment Variables dashboard.
# NEVER commit real production credentials to GitHub.

# 1. Server Runtime & Security
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://thecandlorre.com
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_SECRET=

# 2. Master Administrator Credentials
ADMIN_EMAIL=thecandlorre@gmail.com
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# 3. Shopify Storefront & Admin API
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-04
SHOPIFY_WEBHOOK_SECRET=

# 4. Shiprocket Logistics Integration
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_CHANNEL_ID=
SHIPROCKET_WEBHOOK_TOKEN=

# 5. Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 6. SMS Gateways (Twilio or MSG91 for COD OTP)
OTP_PROVIDER=auto
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CNDLR
MSG91_TEMPLATE_ID=

# 7. Store Alerts & Reports
ALERT_EMAIL_TO=thecandlorre@gmail.com
EMAIL_PROVIDER=console
EMAIL_FROM=The Candlorre Alerts <alerts@thecandlorre.com>
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
CRITICAL_STOCK_THRESHOLD=2
LOW_STOCK_THRESHOLD=5
WARNING_STOCK_THRESHOLD=10
DAILY_INVENTORY_REPORT_HOUR=9
DAILY_SALES_REPORT_HOUR=21
ENABLE_WEEKLY_BUSINESS_REPORT=false

# 8. Contact & Concierge
WHATSAPP_NUMBER=+919762831995
SUPPORT_EMAIL=support@thecandlorre.com
SUPPORT_PHONE=+91 9762831995

# 9. Google OAuth & Analytics
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://thecandlorre.com/api/auth/google/callback
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
GOOGLE_ADS_ID=
